{
  "name": "@cloud-to-code/generator-cdk",
  "version": "0.1.0",
  "description": "Deterministic AWS CDK v2 (TypeScript) generation from a snapshot and a verified reconstruction plan.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/cloud-to-code.git",
    "directory": "packages/generator-cdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@cloud-to-code/core": "workspace:*",
    "@cloud-to-code/diagram-mermaid": "workspace:*",
    "@cloud-to-code/reconstruction": "workspace:*"
  },
  "devDependencies": {
    "@cloud-to-code/testing": "workspace:*",
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
