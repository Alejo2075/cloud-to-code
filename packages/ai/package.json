{
  "name": "@cloud-to-code/ai",
  "version": "0.1.0",
  "description": "Standalone AI providers and orchestration for Cloud to Code: consent-gated, schema-validated, advisory only.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alejo2075/cloud-to-code.git",
    "directory": "packages/ai"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
