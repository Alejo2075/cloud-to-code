  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@cloud-to-code/core": "workspace:*",
    "@cloud-to-code/reconstruction": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloud-to-code/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
