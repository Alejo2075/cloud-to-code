{
  "name": "@cloud-to-code/mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for Cloud to Code: deterministic discovery, questions, decisions, CDK generation and validation tools for any MCP host. Read-only on AWS; no deploy, import, delete or shell tools.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aws",
    "cdk",
    "claude-code",
    "codex",
    "infrastructure-as-code"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/cloud-to-code.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "c2c-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@cloud-to-code/core": "workspace:*",
    "@cloud-to-code/diagram-mermaid": "workspace:*",
    "@cloud-to-code/generator-cdk": "workspace:*",
    "@cloud-to-code/provider-aws": "workspace:*",
    "@cloud-to-code/reconstruction": "workspace:*",
    "@cloud-to-code/validator": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloud-to-code/cli": "workspace:*",
    "@cloud-to-code/testing": "workspace:*"
  }
}
