{
  "name": "@cloud-to-code/diagram-mermaid",
  "version": "0.1.0",
  "description": "Deterministic Mermaid diagrams generated from the Cloud to Code evidence graph (never from model prose).",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/cloud-to-code.git",
    "directory": "packages/diagram-mermaid"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@cloud-to-code/core": "workspace:*"
  },
  "devDependencies": {
    "@cloud-to-code/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
