{
  "name": "cloud-to-code-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Cloud to Code: reverse-engineer existing AWS applications into maintainable AWS CDK v2 projects.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "plugins:sync": "node scripts/sync-plugin-skills.mjs",
    "examples:generate": "node scripts/example-project.mjs",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/tsconfig.tsbuildinfo",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
